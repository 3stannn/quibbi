# Copy to .env in the repository root. Never commit real secrets.
NODE_ENV=development
PORT=3001
APP_ORIGIN=http://localhost:5173
MONGODB_URI=
MONGODB_DB=quibbi
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Production only: exact count of trusted reverse proxies; 0 for a direct server.
TRUST_PROXY_HOPS=0
