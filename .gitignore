.cache/
.vite/
.eslintcache
.tmp/
.taste-skill/
.kip/profile.json

# Logs and machine-specific editor/OS files
*.log
*.swp
*.swo
*~
.idea/
*.suo
*.user
.DS_Store
Thumbs.db
Desktop.ini

# Keep package-lock.json, source fonts/licenses, and project configuration tracked.
