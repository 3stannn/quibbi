# Workspace dependencies and build output (at any depth)
node_modules/
dist/
*.tsbuildinfo

# Local configuration and secrets; keep the setup template in source control
.env
.env.*
!.env.example
*.local

# Tests, coverage, and browser authentication state
coverage/
playwright-report/
playwright/.cache/
playwright/.auth/
test-results/
blob-report/

